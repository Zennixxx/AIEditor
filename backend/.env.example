# Скопируйте в backend/.env и заполните. Файл .env не коммитится.

# Ключ Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Модели: быстрая — для копилота и семантики музыки, Pro — для анализа видео и автоэдита
GEMINI_MODEL_FAST=gemini-flash-latest
GEMINI_MODEL_PRO=gemini-pro-latest

# Каталог данных (прокси, анализ, проекты). По умолчанию ../data
# AIEDITOR_DATA_DIR=D:\AIEditorData
AIEDITOR_HOST=127.0.0.1
AIEDITOR_PORT=8765
# 1 — включить /api/debug/* эндпоинты
AIEDITOR_DEBUG=0

# Пути к бинарникам; по умолчанию tools/bin/, затем PATH
# FFMPEG_PATH=
# FFPROBE_PATH=
# RIFE_PATH=
