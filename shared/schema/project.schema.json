{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "project.schema.json",
  "title": "AIEditorProjectSchema",
  "description": "Модель проекта AIEditor. Источник правды для TS-типов и Pydantic-моделей. См. docs/CONTRACT.md §2–3, §5.",
  "definitions": {
    "EaseName": {
      "type": "string",
      "enum": ["linear", "hold", "easeIn", "easeOut", "easeInOut"]
    },
    "BezierEase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bezier"],
      "properties": {
        "bezier": {
          "description": "Как CSS cubic-bezier(x1, y1, x2, y2).",
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "Ease": {
      "description": "Интерполяция от ключа к следующему. easeIn=[0.42,0,1,1], easeOut=[0,0,0.58,1], easeInOut=[0.42,0,0.58,1].",
      "oneOf": [{ "$ref": "#/definitions/EaseName" }, { "$ref": "#/definitions/BezierEase" }]
    },
    "Keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "v", "ease"],
      "properties": {
        "t": { "type": "number", "description": "Время от начала клипа на таймлайне, сек." },
        "v": { "type": "number" },
        "ease": { "$ref": "#/definitions/Ease" }
      }
    },
    "Animatable": {
      "description": "Число — константа; массив — ключевые кадры.",
      "oneOf": [
        { "type": "number" },
        { "type": "array", "items": { "$ref": "#/definitions/Keyframe" }, "minItems": 1 }
      ]
    },
    "Transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "scale", "rotation", "anchorX", "anchorY"],
      "properties": {
        "x": { "$ref": "#/definitions/Animatable" },
        "y": { "$ref": "#/definitions/Animatable" },
        "scale": { "$ref": "#/definitions/Animatable" },
        "rotation": { "$ref": "#/definitions/Animatable" },
        "anchorX": { "type": "number" },
        "anchorY": { "type": "number" }
      }
    },
    "MarkerKind": {
      "type": "string",
      "enum": ["bass", "beat", "downbeat", "onset", "manual", "ai"]
    },
    "Marker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "t", "kind", "strength"],
      "properties": {
        "id": { "type": "string", "pattern": "^(mrk|tmp)_" },
        "t": { "type": "number", "description": "Source time (маркер клипа) или timeline time (маркер проекта)." },
        "kind": { "$ref": "#/definitions/MarkerKind" },
        "strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "label": { "type": "string" },
        "color": { "type": "string" }
      }
    },
    "SectionLabel": {
      "type": "string",
      "enum": ["intro", "verse", "build", "drop", "break", "outro", "other"]
    },
    "Section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start", "end", "label", "energy"],
      "properties": {
        "id": { "type": "string", "pattern": "^(sec|tmp)_" },
        "start": { "type": "number" },
        "end": { "type": "number" },
        "label": { "$ref": "#/definitions/SectionLabel" },
        "energy": { "type": "number", "minimum": 0, "maximum": 1 },
        "description": { "type": "string" }
      }
    },
    "EnvelopeCurve": {
      "type": "string",
      "enum": ["linear", "exp", "easeOut"]
    },
    "Envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attack", "hold", "decay", "curve"],
      "properties": {
        "attack": { "type": "number", "minimum": 0 },
        "hold": { "type": "number", "minimum": 0 },
        "decay": { "type": "number", "minimum": 0 },
        "curve": { "$ref": "#/definitions/EnvelopeCurve" }
      }
    },
    "EffectAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["markerId", "offset"],
      "properties": {
        "markerId": { "type": "string" },
        "clipId": { "type": "string" },
        "offset": { "type": "number" }
      }
    },
    "EffectParams": {
      "type": "object",
      "additionalProperties": { "type": ["number", "string", "boolean"] }
    },
    "EffectItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "effect", "start", "duration", "params", "envelope", "enabled"],
      "properties": {
        "id": { "type": "string", "pattern": "^(fx|tmp)_" },
        "type": { "const": "effect" },
        "effect": { "type": "string", "description": "id из shared/effects.json" },
        "start": { "type": "number", "description": "Timeline time (fx-дорожка) или время от начала клипа (clip.effects)." },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "params": { "$ref": "#/definitions/EffectParams" },
        "envelope": { "$ref": "#/definitions/Envelope" },
        "anchor": { "$ref": "#/definitions/EffectAnchor" },
        "enabled": { "type": "boolean" }
      }
    },
    "RampKeyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["u", "speed", "ease"],
      "properties": {
        "u": { "type": "number", "minimum": 0, "maximum": 1 },
        "speed": { "type": "number", "exclusiveMinimum": 0 },
        "ease": { "$ref": "#/definitions/Ease" }
      }
    },
    "TimeRemapFit": {
      "type": "string",
      "enum": ["stretch", "free"]
    },
    "TimeRemap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyframes", "fit", "frameBlend"],
      "properties": {
        "keyframes": { "type": "array", "items": { "$ref": "#/definitions/RampKeyframe" }, "minItems": 2 },
        "fit": { "$ref": "#/definitions/TimeRemapFit" },
        "frameBlend": { "type": "boolean" }
      }
    },
    "BlendMode": {
      "type": "string",
      "enum": ["normal", "add", "screen", "multiply", "overlay"]
    },
    "Clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "type", "assetId", "start", "duration", "sourceIn", "sourceOut", "speed", "reverse",
        "transform", "opacity", "blendMode", "effects", "markers"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^(clp|tmp)_" },
        "type": { "const": "clip" },
        "assetId": { "type": "string" },
        "start": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "sourceIn": { "type": "number", "minimum": 0 },
        "sourceOut": { "type": "number", "exclusiveMinimum": 0 },
        "speed": { "type": "number", "exclusiveMinimum": 0 },
        "reverse": { "type": "boolean" },
        "timeRemap": { "$ref": "#/definitions/TimeRemap" },
        "transform": { "$ref": "#/definitions/Transform" },
        "opacity": { "$ref": "#/definitions/Animatable" },
        "blendMode": { "$ref": "#/definitions/BlendMode" },
        "volume": { "$ref": "#/definitions/Animatable" },
        "effects": { "type": "array", "items": { "$ref": "#/definitions/EffectItem" } },
        "markers": { "type": "array", "items": { "$ref": "#/definitions/Marker" } },
        "sections": {
          "type": "array",
          "items": { "$ref": "#/definitions/Section" },
          "description": "Секции музыки в SOURCE time (из анализа), двигаются вместе с клипом. Только у audio-клипов и видеоклипов со звуком."
        },
        "interpolatedAssetId": { "type": "string" },
        "label": { "type": "string" },
        "color": { "type": "string" }
      }
    },
    "TrackKind": {
      "type": "string",
      "enum": ["video", "audio", "fx"]
    },
    "TrackItem": {
      "oneOf": [{ "$ref": "#/definitions/Clip" }, { "$ref": "#/definitions/EffectItem" }]
    },
    "Track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "muted", "locked", "hidden", "items"],
      "properties": {
        "id": { "type": "string", "pattern": "^(trk|tmp)_" },
        "kind": { "$ref": "#/definitions/TrackKind" },
        "name": { "type": "string" },
        "muted": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "volume": { "type": "number", "minimum": 0, "maximum": 2 },
        "items": { "type": "array", "items": { "$ref": "#/definitions/TrackItem" } }
      }
    },
    "AssetKind": {
      "type": "string",
      "enum": ["video", "audio", "image"]
    },
    "AssetStatus": {
      "type": "string",
      "enum": ["importing", "ready", "failed"]
    },
    "AssetDerived": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proxy": { "type": "string" },
        "mezzanine": { "type": "string" },
        "audio": { "type": "string" },
        "thumbs": { "type": "string" },
        "waveform": { "type": "string" }
      }
    },
    "AssetParent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "kind", "factor", "sourceIn", "sourceOut"],
      "properties": {
        "assetId": { "type": "string" },
        "kind": { "const": "interpolated" },
        "factor": { "type": "integer", "minimum": 2 },
        "sourceIn": { "type": "number" },
        "sourceOut": { "type": "number" },
        "quality": { "enum": ["rife", "fallback"] }
      }
    },
    "Asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "path", "duration", "hasAudio", "codec", "browserDecodable", "status", "derived"],
      "properties": {
        "id": { "type": "string", "pattern": "^ast_" },
        "kind": { "$ref": "#/definitions/AssetKind" },
        "name": { "type": "string" },
        "path": { "type": "string" },
        "duration": { "type": "number", "minimum": 0 },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "fps": { "type": "number" },
        "hasAudio": { "type": "boolean" },
        "codec": { "type": "string" },
        "browserDecodable": { "type": "boolean" },
        "status": { "$ref": "#/definitions/AssetStatus" },
        "derived": { "$ref": "#/definitions/AssetDerived" },
        "parent": { "$ref": "#/definitions/AssetParent" }
      }
    },
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "id", "name", "fps", "width", "height", "duration", "background",
        "assets", "tracks", "markers", "sections", "createdAt", "updatedAt", "revision"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "type": "string", "pattern": "^prj_" },
        "name": { "type": "string" },
        "fps": { "type": "number", "enum": [24, 25, 30, 50, 60] },
        "width": { "type": "integer", "minimum": 16 },
        "height": { "type": "integer", "minimum": 16 },
        "duration": { "type": "number", "minimum": 0 },
        "background": { "type": "string" },
        "assets": { "type": "array", "items": { "$ref": "#/definitions/Asset" } },
        "tracks": { "type": "array", "items": { "$ref": "#/definitions/Track" } },
        "markers": { "type": "array", "items": { "$ref": "#/definitions/Marker" } },
        "sections": {
          "type": "array",
          "items": { "$ref": "#/definitions/Section" },
          "description": "Секции композиции в timeline time (ручные / ИИ). Секции из анализа музыки живут в clip.sections."
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "revision": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
